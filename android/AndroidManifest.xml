<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.unchaxun.app">
    <!-- 版本号故意不写在这儿：build.sh 从根目录 index.html 的 APP_VERSION 读出来，
         再由 aapt2 的 version-code / version-name 参数注入，避免两头维护对不上 -->

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <!-- 查询、收藏、导出全在本地跑；只有「同步个人数据」的取件码需要联网 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/UchxTheme"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
